# Copy this file to .env and fill in the two values. Never commit .env.

# From @BotFather (/newbot)
BOT_TOKEN=1234567890:AAH...your-token...

# Numeric Telegram user ID of the bakery owner (send any message to @userinfobot)
OWNER_ID=123456789

# Language of the owner's order cards and buttons: uz or ru
OWNER_LANG=uz

# ---- Mini App (the iOS-style catalog) ----
# Local port the Mini App is served on. Change it if 8080 is taken.
WEBAPP_PORT=8080
# Leave empty: the bot starts a free Cloudflare quick tunnel (needs `cloudflared`, see README)
# and gets a new https://....trycloudflare.com address on every start.
# Or put a permanent https address here that forwards to WEBAPP_PORT.
WEBAPP_URL=
# off = never start a tunnel (customers then get the simple button menu)
TUNNEL=on
# Optional: how to start cloudflared, if it's not simply on PATH. From VS Code installed via
# Flathub (a sandbox), use the system's copy:  CLOUDFLARED=flatpak-spawn --host cloudflared
# CLOUDFLARED=

# ---- Telegram HTML widgets (Bot API 10.4) ----
# Telegram currently refuses widgets from ordinary bots (INPUT_MEDIA_WIDGET_NOT_ALLOWED).
# The code is ready; switch to on if Telegram enables them again. The Mini App, when running, comes first.
WIDGETS=off

# ---- Static showcase (optional) ----
# Your Netlify address (README, section "Showcase"). When the live bot is stopped, the 🍰 Katalog
# button opens the showcase instead, so clients can try the app even with this laptop off.
# SHOWCASE_URL=https://your-site.netlify.app

# Optional:
# DB_PATH=data/bakery.db
# CATALOG_PATH=catalog.yaml
